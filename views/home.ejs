<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
</head>
<body>


<h1>Welcome to the URL Shortener</h1>
<% if(shortId && redirectURL){ %>
    <p>Here is your shortened URL: http://localhost:3000/<%= shortId %></p>

<% } %>
   
<div>   
    <form method="POST" action="/"> 
        <label>enter your original URL:</label>
        <input
        type="text"
        name="redirectURL"
        placeholder="Enter your original URL"
        />
        <button type="submit">generate</button>
    </form>
</div>

<div>
   <% if(locals.urls){%>
    <table>
        <thead>
            <tr>
                <th>s.no</th>
                <th>short id</th>
                <th>original url </th>
                <th>clicks</th>
            </tr>
        </thead>
        <tbody>
            <% urls.forEach((url, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= url.shortId %></td>
                    <td><%= url.redirectURL %></td>
                    <td><%= url.visitHistory.length %></td>
                </tr>

            <% }); %>

        </tbody>

    </table>

<% } %>
</div>



</body>
</html>
